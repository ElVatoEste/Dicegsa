ray></mxGeometry></mxCell><mxCell id="s35" value="baja indicada&lt;br&gt;por televentas" style="endArrow=open;endSize=10;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Helvetica;" edge="1" parent="1" source="s23" target="s27"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="s36" value="" style="endArrow=open;endSize=10;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Helvetica;" edge="1" parent="1" source="s27" target="s28"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s37" value="Dentro de Vigente, una marca del alistador lleva la línea a cualquiera de los tres estados mientras el PKL es trabajable; se dibujan las transiciones habituales. Una línea no encontrada frena la entrega; la dada de baja sale del conteo del Desempeño." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="360" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
